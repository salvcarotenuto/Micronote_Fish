{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Micronote": {
    "MultiCompany": {
      "Enabled": true
    },
    "Database": {
      "MasterDatabase": "MicroFish_Master",
      "CompanyDatabasePattern": "MicroFish_{0:0000}"
    }
  },
  "AllowedHosts": "*"
}


