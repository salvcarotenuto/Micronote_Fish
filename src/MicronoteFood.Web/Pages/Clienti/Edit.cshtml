@page "{code:int?}"
@using System.Globalization
@model MicronoteFood.Web.Pages.Clienti.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Nuovo cliente" : "Scheda cliente";
}

<section class="module-page form-module-page supplier-form-page data-form-skin">
    <header class="module-header">
        <div class="module-title-identity">
            <a class="module-title-logo" asp-page="./Index" aria-label="Esci dalla scheda">
                <img src="~/images/micronote-logo.jpeg" alt="" />
            </a>
            <div>
                <h1>@(Model.IsNew ? "Nuovo cliente" : "Scheda cliente")</h1>
                <p>
                    @(Model.IsNew
                        ? "Inserimento di una nuova anagrafica."
                        : $"Codice {Model.Customer.Code:00000}")
                </p>
            </div>
        </div>
        <div class="top-actions">
            <button class="button button-primary primary" type="button" data-customer-save>
                Salva
            </button>
            <a class="button button-secondary secondary" asp-page="./Index">Annulla</a>
        </div>
    </header>

    <form id="customer-form"
          method="post"
          class="entity-form"
          data-progress-disabled="true"
          data-enter-navigation>
        <input asp-for="Customer.Code" type="hidden" />
        <input asp-for="Azione" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <fieldset class="form-frame compact-frame">
            <legend>Anagrafica</legend>
            <div class="form-grid form-grid-4 form-frame-grid">
                <div class="field field-code">
                    <label>Codice</label>
                    <input type="text"
                           class="readonly-field code-display"
                           readonly
                           tabindex="-1"
                           value="@(Model.IsNew ? Model.DisplayCode.ToString("00000") : Model.Customer.Code.ToString("00000"))" />
                </div>
                <div class="field field-span-2">
                    <label asp-for="Customer.Name"></label>
                    <input asp-for="Customer.Name" autofocus />
                    <span asp-validation-for="Customer.Name"></span>
                </div>
                <div class="field">
                    <label asp-for="Customer.TaxCode"></label>
                    <input asp-for="Customer.TaxCode" class="text-uppercase" />
                    <span asp-validation-for="Customer.TaxCode"></span>
                </div>
                <div class="supplier-location-row">
                    <div class="field">
                        <label asp-for="Customer.City"></label>
                        <input asp-for="Customer.City"
                               list="ComuniList"
                               autocomplete="off"
                               data-comune-city />
                        <span asp-validation-for="Customer.City"></span>
                    </div>
                    <div class="field field-small">
                        <label asp-for="Customer.Province"></label>
                        <input asp-for="Customer.Province"
                               class="text-uppercase"
                               autocomplete="off"
                               data-comune-province />
                        <span asp-validation-for="Customer.Province"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Customer.PostalCode"></label>
                        <input asp-for="Customer.PostalCode"
                               inputmode="numeric"
                               autocomplete="off"
                               data-comune-postal-code />
                        <span asp-validation-for="Customer.PostalCode"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Customer.VatNumber"></label>
                        <input asp-for="Customer.VatNumber" inputmode="numeric" />
                        <span asp-validation-for="Customer.VatNumber"></span>
                    </div>
                </div>
                <div class="field field-span-2 field-address">
                    <label asp-for="Customer.Address"></label>
                    <input asp-for="Customer.Address" />
                    <span asp-validation-for="Customer.Address"></span>
                </div>
                <div class="field field-country">
                    <label asp-for="Customer.CountryCode"></label>
                    <select asp-for="Customer.CountryCode" asp-items="Model.Countries">
                        <option value=""></option>
                    </select>
                </div>
                <div class="field field-legal-nature">
                    <label asp-for="Customer.LegalNatureCode"></label>
                    <select asp-for="Customer.LegalNatureCode" asp-items="Model.LegalNatures">
                        <option value=""></option>
                    </select>
                </div>
                <div class="field field-active field-check">
                    <div class="check-button-field">
                        <input asp-for="Customer.IsActive" />
                        <label class="check-text" asp-for="Customer.IsActive">
                            Cliente attivo
                        </label>
                        <label class="check-button-wrap"
                               for="Customer_IsActive"
                               aria-label="Cliente attivo"></label>
                    </div>
                </div>
            </div>
        </fieldset>

        <fieldset class="form-frame compact-frame">
            <legend>Recapiti</legend>
            <div class="form-grid form-grid-4 form-frame-grid">
                <div class="field field-span-2">
                    <label asp-for="Customer.Phone"></label>
                    <input asp-for="Customer.Phone" inputmode="tel" />
                </div>
                <div class="field field-span-2">
                    <label asp-for="Customer.Mobile"></label>
                    <input asp-for="Customer.Mobile" inputmode="tel" />
                </div>
                <div class="supplier-email-row">
                    <div class="field">
                        <label asp-for="Customer.Email"></label>
                        <input asp-for="Customer.Email" type="email" />
                        <span asp-validation-for="Customer.Email"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Customer.CertifiedEmail"></label>
                        <input asp-for="Customer.CertifiedEmail" type="email" />
                        <span asp-validation-for="Customer.CertifiedEmail"></span>
                    </div>
                </div>
                <div class="field field-span-2">
                    <label asp-for="Customer.Contact"></label>
                    <input asp-for="Customer.Contact" />
                </div>
                <div class="field field-span-2">
                    <label asp-for="Customer.ContactMobile"></label>
                    <input asp-for="Customer.ContactMobile" inputmode="tel" />
                </div>
            </div>
        </fieldset>

        <fieldset class="form-frame compact-frame">
            <legend>Dati gestionali</legend>
            <div class="form-grid form-grid-4 form-frame-grid">
                <div class="field field-span-2">
                    <label asp-for="Customer.AccountCode"></label>
                    <select asp-for="Customer.AccountCode" asp-items="Model.Accounts">
                        <option value=""></option>
                    </select>
                    <span asp-validation-for="Customer.AccountCode"></span>
                </div>
                <div class="field">
                    <label asp-for="Customer.SdiCode"></label>
                    <input asp-for="Customer.SdiCode" class="text-uppercase" />
                </div>
                <div class="field">
                    <label asp-for="Customer.StoreCode"></label>
                    <select asp-for="Customer.StoreCode" asp-items="Model.Stores">
                        <option value=""></option>
                    </select>
                </div>
                <div class="field">
                    <label asp-for="Customer.CategoryCode"></label>
                    <select asp-for="Customer.CategoryCode" asp-items="Model.Categories">
                        <option value=""></option>
                    </select>
                </div>
                <div class="field">
                    <label asp-for="Customer.PriceList"></label>
                    <input asp-for="Customer.PriceList"
                           type="number"
                           min="0"
                           max="255"
                           inputmode="numeric" />
                    <span asp-validation-for="Customer.PriceList"></span>
                </div>
                <div class="field">
                    <label asp-for="Customer.CreditLimit"></label>
                    <input asp-for="Customer.CreditLimit"
                           type="text"
                           inputmode="decimal"
                           maxlength="13"
                           autocomplete="off"
                           class="money-input currency-display"
                           data-money-field
                           data-money-integer-digits="9" />
                    <span asp-validation-for="Customer.CreditLimit"></span>
                </div>
                <div class="field">
                    <label asp-for="Customer.PaymentCode"></label>
                    <select asp-for="Customer.PaymentCode" asp-items="Model.Payments">
                        <option value=""></option>
                    </select>
                </div>
                <div class="field">
                    <label asp-for="Customer.BankCode"></label>
                    <select asp-for="Customer.BankCode" asp-items="Model.Banks">
                        <option value=""></option>
                    </select>
                </div>
                <div class="field">
                    <label asp-for="Customer.OpeningBalance"></label>
                    <input type="text"
                           class="readonly-field currency-display"
                           readonly
                           tabindex="-1"
                           value="@(Model.Customer.OpeningBalance?.ToString("#,##0.00", CultureInfo.GetCultureInfo("it-IT")))" />
                </div>
                <div class="field">
                    <label asp-for="Customer.AgentCode"></label>
                    <select asp-for="Customer.AgentCode" asp-items="Model.Agents">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </fieldset>

    </form>
    <datalist id="ComuniList"></datalist>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/comuni-assist.js" asp-append-version="true"></script>
    <script src="~/js/form-enter-navigation.js" asp-append-version="true"></script>
    <script src="~/js/customer-edit.js" asp-append-version="true"></script>
}
