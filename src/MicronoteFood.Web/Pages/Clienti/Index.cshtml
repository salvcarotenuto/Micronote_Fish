@page
@model MicronoteFood.Web.Pages.Clienti.IndexModel
@{
    ViewData["Title"] = "Clienti";
    ViewData["BodyClass"] = "list-module";
}

<section class="list-page customer-list-page" data-list-page data-menu-url="/">
    <header class="list-titlebar">
        <a class="list-title-identity" asp-page="/Index" aria-label="Torna al menu principale">
            <img src="~/images/micronote-logo.jpeg" alt="" />
            <span>
                <strong>Clienti</strong>
                <small>Micronote Food - Gestione clienti</small>
            </span>
        </a>
        <div class="list-title-actions">
            <a class="list-title-button" asp-page="./Edit">Aggiungi</a>
            <button class="list-title-button" type="button" data-customer-action="edit">
                Modifica
            </button>
            <button class="list-title-button" type="button" data-customer-action="delete">
                Elimina
            </button>
            <button class="list-title-button" type="button" data-customer-action="print">
                Stampa lista
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <span hidden data-page-message data-message-variant="error"
              data-message-text="@Model.ErrorMessage"></span>
    }

    <section class="list-panel">
        <div class="list-toolbar">
            <div class="list-filter-field list-search-field">
                <label for="customer-search">Cerca</label>
                <div class="list-search-control">
                    <input id="customer-search"
                           type="text"
                           placeholder="Nome cliente"
                           autocomplete="off"
                           autofocus
                           data-customer-search />
                    <button class="list-search-clear"
                            type="button"
                            aria-label="Pulisci filtro"
                            data-customer-search-clear
                            hidden>
                        ×
                    </button>
                </div>
            </div>
            <div class="list-filter-field list-account-field">
                <label for="customer-account">Contropartita</label>
                <select id="customer-account" data-customer-account>
                    <option value="">Tutte</option>
                    @foreach (var account in Model.Accounts)
                    {
                        <option value="@account.Code">@account.Description</option>
                    }
                </select>
            </div>
            <span class="list-records-box">
                <strong data-customer-count>@Model.Customers.Count</strong>
                <span>record</span>
            </span>
        </div>

        <div class="list-grid-frame" data-customer-grid>
            <table class="list-grid">
                <thead>
                    <tr>
                        <th data-sort-key="code" data-sort-type="number">Codice</th>
                        <th data-sort-key="name">Nome</th>
                        <th data-sort-key="city">Sede</th>
                        <th data-sort-key="province">Prov.</th>
                        <th data-sort-key="vat">Partita IVA</th>
                        <th data-sort-key="phone">Telefono</th>
                        <th data-sort-key="email">E-mail</th>
                        <th data-sort-key="account">Contropartita</th>
                        <th data-sort-key="store">Punto vendita</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model.Customers)
                    {
                        <tr tabindex="0"
                            class="@(!customer.IsActive ? "is-inactive" : null)"
                            data-customer-row
                            data-account-code="@customer.AccountCode"
                            data-filter-name="@customer.Name"
                            data-sort-code="@customer.Code"
                            data-sort-name="@customer.Name"
                            data-sort-city="@customer.City"
                            data-sort-province="@customer.Province"
                            data-sort-vat="@customer.VatNumber"
                            data-sort-phone="@customer.Phone"
                            data-sort-email="@customer.Email"
                            data-sort-account="@customer.AccountDescription"
                            data-sort-store="@customer.StoreName"
                            data-edit-url="@Url.Page("./Edit", new { code = customer.Code })"
                            data-delete-code="@customer.Code"
                            data-print-code="@customer.Code"
                            data-record-label="@customer.Name">
                            <td class="code-cell">@customer.Code.ToString("00000")</td>
                            <td>@customer.Name</td>
                            <td>@customer.City</td>
                            <td>@customer.Province</td>
                            <td>@customer.VatNumber</td>
                            <td>@customer.Phone</td>
                            <td>@customer.Email</td>
                            <td title="@customer.AccountDescription">
                                @customer.AccountDescription
                            </td>
                            <td>@customer.StoreName</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="list-empty" data-customer-empty hidden>
                Nessun cliente trovato.
            </div>
        </div>
    </section>

    <form method="post" asp-page-handler="Delete" data-customer-delete-form hidden>
        <input type="hidden" name="code" data-customer-delete-code />
    </form>

    <div class="report-preview-backdrop" data-customer-print-preview hidden>
        <section class="report-preview-window" role="dialog" aria-modal="true" aria-labelledby="customerPrintPreviewTitle">
            <header class="report-preview-toolbar">
                <div>
                    <strong id="customerPrintPreviewTitle">Anteprima lista clienti</strong>
                    <span data-customer-print-summary></span>
                </div>
                <div class="report-preview-actions">
                    <button type="button" data-customer-preview-zoom-out aria-label="Riduci anteprima">−</button>
                    <span data-customer-preview-zoom-label>100%</span>
                    <button type="button" data-customer-preview-zoom-in aria-label="Ingrandisci anteprima">+</button>
                    <button type="button" data-customer-preview-print>Stampa</button>
                    <button type="button" data-customer-preview-pdf>File PDF</button>
                    <button type="button" class="report-preview-close" data-customer-preview-close>Chiudi</button>
                </div>
            </header>
            <div class="report-preview-viewport">
                <div class="report-preview-document" data-customer-preview-document></div>
            </div>
        </section>
    </div>
</section>

@section Scripts {
    <script src="~/js/customers-list.js" asp-append-version="true"></script>
}
