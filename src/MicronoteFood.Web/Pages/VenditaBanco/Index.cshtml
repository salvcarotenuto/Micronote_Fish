@page
@model MicronoteFood.Web.Pages.VenditaBanco.IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "Vendita al banco";
    ViewData["BodyClass"] = "counter-sale-body";
    var payload = JsonSerializer.Serialize(new {
        enableAmountEditing = Model.Data.EnableAmountEditing,
        initialGrouping = Model.Data.InitialGrouping,
        articles = Model.Data.Articles.Select(a => new {
            code=a.Code, description=a.Description, unit=a.Unit,
            categoryCode=a.CategoryCode, category=a.Category,
            groupCode=a.GroupCode, group=a.Group,
            speciesCode=a.SpeciesCode, species=a.Species,
            originCode=a.OriginCode, origin=a.Origin,
            tare=a.Tare, stock=a.Stock, price=a.Price, vatRate=a.VatRate
        }),
        customers = Model.Data.Customers.Select(c => new {
            code=c.Code, name=c.Name, storeCode=c.StoreCode
        })
    });
}

<section class="counter-sale" data-counter-sale>
    <header class="counter-sale-header">
        <a class="counter-sale-brand" href="/Menu?section=vendite" aria-label="Torna al menu Vendite">
            <img src="~/images/micronote-logo.jpeg" alt="" />
            <strong>Vendita al banco</strong>
        </a>
        <div class="counter-sale-date">@Model.Data.Date.ToString("dd MMM yyyy")</div>
        <div class="counter-sale-clock" data-clock></div>
        <div class="counter-sale-tabs" role="tablist">
            <button type="button" class="is-active" data-dimension="category">Categorie</button>
            <button type="button" data-dimension="group">Gruppi</button>
            <button type="button" data-dimension="species">Specie</button>
            <button type="button" data-dimension="origin">Provenienza</button>
        </div>
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="status-message success">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="status-message error">@error</div>
    }

    <nav class="counter-sale-groups" data-groups aria-label="Classificazioni articoli"></nav>

    <div class="counter-sale-customer-row">
        <div class="counter-sale-customer">
            <button type="button" data-customer-open>Cliente</button>
            <strong data-customer-code></strong>
            <span data-customer-name></span>
            <button type="button" class="clear" data-customer-clear aria-label="Rimuovi cliente">×</button>
        </div>
        <div class="counter-sale-search">
            <label for="counterSaleSearch">Cerca</label>
            <input id="counterSaleSearch" type="search" autocomplete="off"
                   placeholder="Codice o descrizione articolo" data-article-search />
            <output data-article-count></output>
        </div>
    </div>

    <main class="counter-sale-workspace">
        <section class="counter-sale-cart" aria-label="Righe vendita">
            <div class="counter-sale-cart-head">
                <span>Articolo</span><span>Descrizione</span><span>Quantità</span>
                <span>Iva</span><span>Prezzo</span><span>Importo</span>
            </div>
            <div class="counter-sale-cart-list" data-cart-list>
                <div class="counter-sale-empty">Tocca un articolo per iniziare la vendita</div>
            </div>
        </section>
        <section class="counter-sale-catalog" aria-label="Lista articoli">
            <div class="counter-sale-article-scroll" data-article-scroll>
                <div class="counter-sale-article-head">
                    <span>Codice</span><span>Descrizione</span><span>Prezzo</span>
                </div>
                <div role="listbox" aria-label="Articoli" data-article-list></div>
            </div>
        </section>
    </main>

    <footer class="counter-sale-footer">
        <div class="counter-sale-totals">
            <div><span>Merce</span><strong data-total-net>0,00</strong></div>
            <div><span>I.v.a.</span><strong data-total-vat>0,00</strong></div>
            <div><span>Totale vendita</span><strong data-total>0,00</strong></div>
        </div>
        <div class="counter-sale-actions">
            <button type="button" data-balance disabled>Saldo cliente</button>
            <button type="button" data-add disabled>Aggiungi articolo</button>
            <button type="button" data-edit disabled>Modifica articolo</button>
            <button type="button" data-remove disabled>Rimuovi articolo</button>
            <button type="button" data-card disabled>Scheda articolo</button>
            <button type="button" class="primary" data-close disabled>Chiudi vendita</button>
            <button type="button" class="danger" data-cancel disabled>Annulla vendita</button>
            <a href="/Menu?section=vendite">Esci</a>
        </div>
    </footer>

    <form method="post" asp-page-handler="Close" hidden data-sale-form>
        <input type="hidden" asp-for="SalePayload" data-sale-payload />
    </form>

    <div class="counter-sale-overlay" hidden data-customer-modal>
        <section class="counter-sale-dialog customer-dialog" role="dialog" aria-modal="true">
            <header><h2>Seleziona cliente</h2><button type="button" data-customer-close>×</button></header>
            <input type="search" placeholder="Codice o ragione sociale" autocomplete="off" data-customer-search />
            <div class="counter-sale-customer-list" data-customer-list></div>
        </section>
    </div>

    <div class="counter-sale-overlay" hidden data-row-modal>
        <section class="counter-sale-dialog row-dialog" role="dialog" aria-modal="true">
            <header><h2 data-row-title>Inserimento articolo</h2><button type="button" data-row-cancel>×</button></header>
            <div class="counter-sale-row-panel">
                <div class="counter-sale-row-article">
                    <span>Articolo</span><strong data-row-code></strong><b data-row-description></b>
                </div>
                <div class="counter-sale-row-fields">
                    <div class="counter-sale-row-column counter-sale-row-info">
                        <label><span>Giacenza</span><input readonly data-row-stock /></label>
                        <div class="counter-sale-last-price">
                            <span>Ultimo prezzo</span><input readonly data-row-last-price />
                            <em>iva</em><input readonly data-row-last-vat />
                        </div>
                        <label><span>Tara</span><input readonly data-row-tare /></label>
                    </div>
                    <div class="counter-sale-row-column counter-sale-row-measures">
                        <label><span>Un. di misura</span><input readonly data-row-unit /></label>
                        <label><span>Colli</span><input inputmode="numeric" data-row-packages /></label>
                    </div>
                    <div class="counter-sale-row-column counter-sale-row-values">
                        <label><span>Peso</span><input inputmode="decimal" data-row-quantity /></label>
                        <label><span>Prezzo</span><input inputmode="decimal" data-row-price /></label>
                        <label><span>I.v.a.</span><input inputmode="decimal" data-row-vat /></label>
                        <label><span>Prezzo ivato</span><input readonly data-row-vat-price /></label>
                        <label><span>Importo</span><input readonly data-row-amount /></label>
                    </div>
                </div>
            </div>
            <footer>
                <button type="button" class="primary" data-row-confirm>Conferma</button>
                <button type="button" data-row-cancel>Annulla</button>
            </footer>
        </section>
    </div>

    <div class="counter-sale-overlay" hidden data-close-modal>
        <section class="counter-sale-dialog close-dialog" role="dialog" aria-modal="true">
            <header><h2>Chiusura vendita</h2><button type="button" data-close-cancel>×</button></header>
            <div><span>Totale articoli</span><strong data-close-gross></strong></div>
            <label>Abbuono<input inputmode="decimal" value="0,00" data-close-discount /></label>
            <div><span>Totale documento</span><strong data-close-total></strong></div>
            <footer>
                <button type="button" class="primary" data-close-confirm>Registra vendita</button>
                <button type="button" data-close-cancel>Annulla</button>
            </footer>
        </section>
    </div>

    <script type="application/json" data-counter-sale-data>@Html.Raw(payload)</script>
</section>

@section Scripts {
    <script src="~/js/counter-sale.js" asp-append-version="true"></script>
}
