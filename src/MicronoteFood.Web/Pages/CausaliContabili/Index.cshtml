@page
@model MicronoteFood.Web.Pages.CausaliContabili.IndexModel
@{
    ViewData["Title"] = "Causali contabili";
    ViewData["BodyClass"] = "list-module";
}

<section class="module-page list-page accounting-cause-list-page supplier-form-page data-form-skin" data-list-page data-menu-url="/">
    <header class="module-header">
        <div class="module-title-identity">
            <a class="module-title-logo" asp-page="/Index" aria-label="Torna al menu principale">
                <img src="~/images/micronote-logo.jpeg" alt="" />
            </a>
            <div>
                <h1>Causali contabili</h1>
                <p>Micronote Food - Tabelle contabili</p>
            </div>
        </div>
        <div class="top-actions sales-history-actions accounting-cause-title-actions">
            <a class="button button-primary primary" asp-page="./Edit">Aggiungi</a>
            <button class="button button-primary primary" type="button" data-accounting-cause-action="edit">
                Modifica
            </button>
            <button class="button button-primary primary" type="button" data-accounting-cause-action="duplicate">
                Duplica
            </button>
            <button class="button button-primary primary" type="button" data-accounting-cause-action="delete">
                Elimina
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <span hidden data-page-message data-message-variant="error"
              data-message-text="@Model.ErrorMessage"></span>
    }

    <section class="list-panel">
        <div class="list-toolbar accounting-cause-toolbar">
            <div class="list-filter-field list-search-field">
                <label for="accounting-cause-search">Cerca</label>
                <div class="list-search-control">
                    <input id="accounting-cause-search"
                           type="text"
                           placeholder="Descrizione causale"
                           value="@Model.Search"
                           autocomplete="off"
                           autofocus
                           data-accounting-cause-search />
                    <button class="list-search-clear"
                            type="button"
                            aria-label="Pulisci filtro"
                            data-accounting-cause-search-clear
                            hidden>
                        ×
                    </button>
                </div>
            </div>
            <div class="list-filter-field accounting-cause-type-filter">
                <label for="accounting-cause-type">Tipo movimento</label>
                <select id="accounting-cause-type" asp-for="MovementType"
                        data-accounting-cause-type>
                    <option value="">Tutti</option>
                    @foreach (var option in Model.MovementTypeOptions)
                    {
                        <option value="@option.Code">@option.Code - @option.Description</option>
                    }
                </select>
            </div>
            <span class="list-records-box">
                <strong data-accounting-cause-count>@Model.Causes.Count</strong>
                <span>record</span>
            </span>
        </div>

        <div class="list-grid-frame accounting-cause-grid-frame" data-accounting-cause-grid>
            <table class="list-grid accounting-cause-grid">
                <thead>
                    <tr>
                        <th data-sort-key="code" data-sort-type="number">Codice</th>
                        <th data-sort-key="description">Descrizione</th>
                        <th data-sort-key="movementType">Tipo mv.</th>
                        <th data-sort-key="subject">Soggetto</th>
                        <th data-sort-key="sign">Segno</th>
                        <th data-sort-key="cashFlow">E/U</th>
                        <th data-sort-key="debitCode" data-sort-type="number">Dare</th>
                        <th data-sort-key="debitDescription">Conto Dare</th>
                        <th data-sort-key="creditCode" data-sort-type="number">Avere</th>
                        <th data-sort-key="creditDescription">Conto Avere</th>
                        <th data-sort-key="cash">Cassa</th>
                        <th data-sort-key="invoice">Fattura</th>
                        <th data-sort-key="dueDate">Scadenza</th>
                        <th data-sort-key="title">Titolo</th>
                        <th data-sort-key="salary">Stipendio</th>
                        <th data-sort-key="print">Stampa</th>
                        <th data-sort-key="locked">Bloccato</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cause in Model.Causes)
                    {
                        <tr tabindex="0"
                            data-accounting-cause-row
                            data-movement-type="@cause.MovementType"
                            data-filter-description="@cause.Description"
                            data-sort-code="@cause.Code"
                            data-sort-description="@cause.Description"
                            data-sort-movement-type="@cause.MovementType"
                            data-sort-subject="@cause.Subject"
                            data-sort-sign="@cause.Sign"
                            data-sort-cash-flow="@cause.CashFlow"
                            data-sort-debit-code="@cause.DebitCode"
                            data-sort-debit-description="@cause.DebitDescription"
                            data-sort-credit-code="@cause.CreditCode"
                            data-sort-credit-description="@cause.CreditDescription"
                            data-sort-cash="@(cause.Cash ? "1" : "0")"
                            data-sort-invoice="@(cause.Invoice ? "1" : "0")"
                            data-sort-due-date="@(cause.DueDate ? "1" : "0")"
                            data-sort-title="@(cause.Title ? "1" : "0")"
                            data-sort-salary="@(cause.Salary ? "1" : "0")"
                            data-sort-print="@(cause.Print ? "1" : "0")"
                            data-sort-locked="@(cause.Locked ? "1" : "0")"
                            data-edit-url="@Url.Page("./Edit", new { code = cause.Code })"
                            data-duplicate-url="@Url.Page("./Edit", new { code = cause.Code, duplicate = true })"
                            data-delete-code="@cause.Code"
                            data-record-label="@cause.Description">
                            <td class="code-cell">@cause.Code.ToString("000")</td>
                            <td>@cause.Description</td>
                            <td>@cause.MovementType</td>
                            <td>@cause.Subject</td>
                            <td>@cause.Sign</td>
                            <td>@cause.CashFlow</td>
                            <td class="code-cell">@(cause.DebitCode > 0 ? cause.DebitCode.ToString("000") : "")</td>
                            <td>@cause.DebitDescription</td>
                            <td class="code-cell">@(cause.CreditCode > 0 ? cause.CreditCode.ToString("000") : "")</td>
                            <td>@cause.CreditDescription</td>
                            <td>@(cause.Cash ? "Sì" : "")</td>
                            <td>@(cause.Invoice ? "Sì" : "")</td>
                            <td>@(cause.DueDate ? "Sì" : "")</td>
                            <td>@(cause.Title ? "Sì" : "")</td>
                            <td>@(cause.Salary ? "Sì" : "")</td>
                            <td>@(cause.Print ? "Sì" : "")</td>
                            <td>@(cause.Locked ? "Sì" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="list-empty" data-accounting-cause-empty hidden>
                Nessuna causale trovata.
            </div>
        </div>
    </section>

    <form method="post" asp-page-handler="Delete" data-accounting-cause-delete-form hidden>
        <input type="hidden" name="code" data-accounting-cause-delete-code />
    </form>
</section>

@section Scripts {
    <script src="~/js/accounting-causes-list.js" asp-append-version="true"></script>
}
