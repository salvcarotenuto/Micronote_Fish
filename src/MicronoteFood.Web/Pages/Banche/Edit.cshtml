@page "{code:int?}"
@model MicronoteFood.Web.Pages.Banche.EditModel
@{ ViewData["Title"]=Model.IsNew?"Nuova banca":"Scheda banca"; }
<section class="module-page form-module-page supplier-form-page data-form-skin bank-form-page">
 <header class="module-header"><div class="module-title-identity"><a class="module-title-logo" asp-page="./Index" aria-label="Esci dalla scheda"><img src="~/images/micronote-logo.jpeg" alt=""/></a><div><h1>@(Model.IsNew?"Nuova banca":"Scheda banca")</h1><p>@(Model.IsNew?"Registrazione di una nuova banca.":$"Codice {Model.Bank.Code:00000}")</p></div></div><div class="top-actions"><button class="button button-primary primary" type="submit" form="bank-form">Salva</button><a class="button button-secondary secondary" asp-page="./Index">Annulla</a></div></header>
 <form id="bank-form" method="post" class="entity-form" data-enter-navigation><input asp-for="Bank.Code" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
  <fieldset class="form-frame compact-frame"><legend>Anagrafica banca</legend><div class="bank-form-grid">
   <div class="field bank-code"><label>Codice</label><input readonly tabindex="-1" value="@(Model.IsNew?Model.DisplayCode.ToString("00000"):Model.Bank.Code.ToString("00000"))"/></div>
   <div class="field bank-name"><label>Nome</label><input asp-for="Bank.Name" autofocus/><span asp-validation-for="Bank.Name"></span></div>
   <div class="field"><label>Agenzia</label><input asp-for="Bank.Branch"/></div><div class="field"><label>Sito web</label><input asp-for="Bank.Website"/></div>
   <div class="field"><label>E-mail</label><input asp-for="Bank.Email" type="email"/><span asp-validation-for="Bank.Email"></span></div><div class="field"><label>Telefono</label><input asp-for="Bank.Phone" inputmode="tel"/></div>
   <div class="field"><label>Cellulare</label><input asp-for="Bank.Mobile" inputmode="tel"/></div><div class="field"><label>Codice ABI</label><input asp-for="Bank.Abi"/></div>
   <div class="field"><label>CAB</label><input asp-for="Bank.Cab"/></div><div class="field"><label>Codice SWIFT</label><input asp-for="Bank.Swift"/></div>
   <div class="field"><label>SIA</label><input asp-for="Bank.Sia"/></div><div class="field"><label>Numero conto</label><input asp-for="Bank.Account"/></div>
   <div class="field"><label>Codice IBAN</label><input asp-for="Bank.Iban"/></div><div class="field bank-notes"><label>Note</label><input asp-for="Bank.Notes"/></div>
  </div></fieldset>
 </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script src="~/js/form-enter-navigation.js" asp-append-version="true"></script> }
