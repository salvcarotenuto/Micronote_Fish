@page
@model MicronoteFood.Web.Pages.Banche.IndexModel
@{ ViewData["Title"]="Banche"; ViewData["BodyClass"]="list-module"; }
<section class="list-page bank-list-page" data-bank-list data-menu-url="/">
 <header class="list-titlebar"><a class="list-title-identity" asp-page="/Index" aria-label="Torna al menu principale"><img src="~/images/micronote-logo.jpeg" alt=""/><span><strong>Tabella banche</strong><small>Registrazione, cancellazione e modifica anagrafiche banche</small></span></a>
  <div class="list-title-actions"><a class="list-title-button" asp-page="./Edit">Aggiungi</a><button class="list-title-button" type="button" data-bank-action="edit">Modifica</button><button class="list-title-button" type="button" data-bank-action="delete">Elimina</button><button class="list-title-button" type="button" data-bank-action="balance">Vedi saldo</button></div></header>
 @if(!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<span hidden data-page-message data-message-text="@Model.ErrorMessage"></span>}
 <section class="list-panel"><div class="list-toolbar"><div class="list-filter-field list-search-field"><label for="bank-search">Cerca</label><div class="list-search-control"><input id="bank-search" placeholder="Nome o agenzia" autocomplete="off" autofocus data-bank-search/><button class="list-search-clear" type="button" data-bank-clear hidden>×</button></div></div><span class="list-records-box"><strong data-bank-count>@Model.Banks.Count</strong><span>record</span></span></div>
  <div class="list-grid-frame bank-grid-frame"><table class="list-grid bank-grid"><thead><tr><th>Codice</th><th>Nome</th><th>Agenzia</th><th>ABI</th><th>CAB</th><th>Conto</th></tr></thead><tbody>
  @foreach(var bank in Model.Banks){<tr tabindex="0" data-bank-row data-filter="@($"{bank.Name} {bank.Branch} {bank.Abi} {bank.Cab} {bank.Account}")" data-code="@bank.Code" data-label="@bank.Name" data-edit-url="@Url.Page("./Edit",new{code=bank.Code})" data-balance-url="@Url.Page("/MovimentiBanca/Index",new{bankCode=bank.Code})"><td class="code-cell">@bank.Code.ToString("00000")</td><td>@bank.Name</td><td>@bank.Branch</td><td>@bank.Abi</td><td>@bank.Cab</td><td>@bank.Account</td></tr>}
  </tbody></table><div class="list-empty" data-bank-empty hidden>Nessuna banca trovata.</div></div></section>
 <form method="post" asp-page-handler="Delete" data-bank-delete-form hidden><input type="hidden" name="code" data-bank-delete-code/></form>
</section>
@section Scripts { <script src="~/js/banks-list.js" asp-append-version="true"></script> }
