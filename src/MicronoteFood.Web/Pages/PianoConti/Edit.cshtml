@page "{code:int?}"
@model MicronoteFood.Web.Pages.PianoConti.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Nuovo conto" : "Scheda conto";
}

<section class="module-page form-module-page supplier-form-page chart-account-form-page data-form-skin">
    <header class="module-header">
        <div class="module-title-identity">
            <a class="module-title-logo" asp-page="./Index" aria-label="Esci dalla scheda">
                <img src="~/images/micronote-logo.jpeg" alt="" />
            </a>
            <div>
                <h1>@(Model.IsNew ? "Nuovo conto" : "Scheda conto")</h1>
                <p>
                    @(Model.IsNew
                        ? "Inserimento di un nuovo conto."
                        : $"Codice {Model.Account.Code:000}")
                </p>
            </div>
        </div>
        <div class="top-actions">
            <button class="button button-primary primary"
                    type="button"
                    data-chart-account-save>
                Salva
            </button>
            @if (Model.IsModal)
            {
                <button class="button button-secondary secondary" type="button" data-chart-account-modal-cancel>Annulla</button>
            }
            else
            {
                <a class="button button-secondary secondary" asp-page="./Index">Annulla</a>
            }
        </div>
    </header>

    <form id="chart-account-form"
          method="post"
          class="entity-form"
          data-progress-disabled="true"
          data-enter-navigation>
        <input asp-for="Account.IsNew" type="hidden" />
        <input asp-for="Azione" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <fieldset class="form-frame compact-frame">
            <legend>Piano dei conti</legend>
            <div class="chart-account-fields">
                <div class="field chart-account-code-field">
                    <label asp-for="Account.Code"></label>
                    @if (Model.IsNew)
                    {
                        <input asp-for="Account.Code"
                               value="@(Model.Account.Code > 0 ? Model.Account.Code.ToString("000") : "")"
                               type="text"
                               inputmode="numeric"
                               maxlength="3"
                               pattern="[0-9]{1,3}"
                               autocomplete="off"
                               readonly />
                    }
                    else
                    {
                        <input asp-for="Account.Code"
                               value="@Model.Account.Code.ToString("000")"
                               type="text"
                               inputmode="numeric"
                               maxlength="3"
                               pattern="[0-9]{1,3}"
                               autocomplete="off"
                               readonly />
                    }
                    <span asp-validation-for="Account.Code"></span>
                </div>
                <div class="field chart-account-description-field">
                    <label asp-for="Account.Description"></label>
                    <input asp-for="Account.Description" autocomplete="off" autofocus />
                    <span asp-validation-for="Account.Description"></span>
                </div>
                <div class="field chart-account-master-field">
                    <label asp-for="Account.MasterCode"></label>
                    <select asp-for="Account.MasterCode" asp-items="Model.Masters">
                        <option value=""></option>
                    </select>
                    <span asp-validation-for="Account.MasterCode"></span>
                </div>
                <div class="field chart-account-type-field">
                    <label asp-for="Account.Type"></label>
                    <input asp-for="Account.Type"
                           autocomplete="off"
                           readonly
                           data-chart-account-type />
                </div>
                <div class="field chart-account-company-field">
                    <label asp-for="Account.CompanyType"></label>
                    <select asp-for="Account.CompanyType">
                        <option value=""></option>
                        @foreach (var option in Model.CompanyTypeOptions)
                        {
                            <option value="@option.Code">@option.Code - @option.Description</option>
                        }
                    </select>
                </div>
                <div class="field-check chart-account-stock-field">
                    <label class="check-button-field">
                        <span class="check-text">Carico magazzino</span>
                        <input asp-for="Account.StockLoad" type="checkbox" />
                        <span class="check-button-wrap" aria-hidden="true"></span>
                    </label>
                </div>
                <div class="field-check chart-account-locked-field">
                    <label class="check-button-field">
                        <span class="check-text">Bloccato</span>
                        <input asp-for="Account.Locked" type="checkbox" />
                        <span class="check-button-wrap" aria-hidden="true"></span>
                    </label>
                </div>
            </div>
        </fieldset>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.MicronoteChartAccountMasterTypes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MasterTypes));
    </script>
    <script src="~/js/form-enter-navigation.js" asp-append-version="true"></script>
    <script src="~/js/chart-account-edit.js" asp-append-version="true"></script>
}
