@page "{code:int?}"
@model MicronoteFood.Web.Pages.Settori.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Nuovo settore" : "Scheda settore";
}

<section class="module-page form-module-page supplier-form-page data-form-skin sector-form-page">
    <header class="module-header">
        <div class="module-title-identity">
            <a class="module-title-logo" asp-page="./Index" aria-label="Esci dalla scheda">
                <img src="~/images/micronote-logo.jpeg" alt="" />
            </a>
            <div>
                <h1>@(Model.IsNew ? "Nuovo settore" : "Scheda settore")</h1>
                <p>
                    @(Model.IsNew
                        ? "Registrazione di un nuovo settore commerciale."
                        : $"Codice {Model.Sector.Code:000}")
                </p>
            </div>
        </div>
        <div class="top-actions">
            <button class="button button-primary primary" type="submit" form="sector-form">
                Salva
            </button>
            <a class="button button-secondary secondary" asp-page="./Index">Annulla</a>
        </div>
    </header>

    <form id="sector-form"
          method="post"
          class="entity-form"
          data-enter-navigation>
        <input asp-for="Sector.Code" type="hidden" />
        <input asp-for="Azione" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <fieldset class="form-frame compact-frame">
            <legend>Settore commerciale</legend>
            <div class="form-grid form-grid-4 form-frame-grid sector-fields-row">
                <div class="field field-code">
                    <label>Codice</label>
                    <input type="text"
                           class="readonly-field code-display"
                           readonly
                           tabindex="-1"
                           value="@(Model.IsNew ? Model.DisplayCode.ToString("000") : Model.Sector.Code.ToString("000"))" />
                </div>
                <div class="field field-span-2 sector-description-field">
                    <label asp-for="Sector.Description"></label>
                    <input asp-for="Sector.Description" autofocus />
                    <span asp-validation-for="Sector.Description"></span>
                </div>
            </div>
        </fieldset>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-enter-navigation.js" asp-append-version="true"></script>
}
