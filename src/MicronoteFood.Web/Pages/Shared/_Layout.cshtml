<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Micronote Fish</title>
    <link rel="icon" href="~/favicon.ico" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MicronoteFood.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    <div class="page-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="page-container">Micronote Fish &copy; 2026</div>
    </footer>

    <div class="operation-progress-overlay" id="operation-progress" aria-live="polite" aria-hidden="true">
        <div class="operation-progress-box">
            <img src="~/images/Progress_Img.gif" alt="" />
            <span>Operazione in corso...</span>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/article-row-dialog.js" asp-append-version="true"></script>
    <script src="~/js/sales-closure-dialog.js" asp-append-version="true"></script>
    <script src="~/js/messagebox.js" asp-append-version="true"></script>
    <script src="~/js/validation-messagebox.js" asp-append-version="true"></script>
    <script src="~/js/money-fields.js" asp-append-version="true"></script>
    <script src="~/js/decimal-fields.js" asp-append-version="true"></script>
    <script src="~/js/percent-fields.js" asp-append-version="true"></script>
    <script src="~/js/updown.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


