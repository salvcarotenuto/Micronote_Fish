@page "{code?}"
@using System.Globalization
@model MicronoteFood.Web.Pages.Articoli.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Nuovo articolo" : "Scheda articolo";
    var it = CultureInfo.GetCultureInfo("it-IT");
    string Money(decimal? value) => value is null or 0 ? "" : value.Value.ToString("N2", it);
    string Quantity(decimal? value) => value is null or 0 ? "" : value.Value.ToString("N3", it);
}

<section class="module-page form-module-page supplier-form-page data-form-skin article-form-page @(Model.IsReadonly ? "is-readonly" : "")">
    <header class="module-header">
        <div class="module-title-identity">
            <a class="module-title-logo" href="@Model.ReturnUrl" aria-label="Esci dalla scheda">
                <img src="~/images/micronote-logo.jpeg" alt="" />
            </a>
            <div>
                <h1>@(Model.IsNew ? "Nuovo articolo" : "Scheda articolo")</h1>
                <p>
                    @(Model.IsNew
                        ? "Inserimento di un nuovo articolo."
                        : $"Codice {Model.Article.Code}")
                </p>
            </div>
        </div>
        <div class="top-actions">
            @if (Model.IsReadonly)
            {
                <a class="button button-secondary secondary"
                   href="@Model.ReturnUrl"
                   data-article-modal-cancel="@Model.IsModal.ToString().ToLowerInvariant()">Chiudi</a>
            }
            else
            {
                <button class="button button-primary primary" type="submit" form="article-form" data-article-save>
                    Salva
                </button>
                <a class="button button-secondary secondary"
                   href="@Model.ReturnUrl"
                   data-article-modal-cancel="@Model.IsModal.ToString().ToLowerInvariant()">Annulla</a>
            }
        </div>
    </header>

    <form id="article-form"
          method="post"
          class="entity-form"
          data-progress-disabled="true"
          data-enter-navigation>
        <input asp-for="ReturnUrl" type="hidden" />
        <input asp-for="Azione" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <fieldset class="form-frame compact-frame article-form-frame" disabled="@Model.IsReadonly">
            <div class="article-fields-grid">
                <div class="field article-code-field">
                    <label asp-for="Article.Code"></label>
                    <input asp-for="Article.Code"
                           readonly="@(!Model.IsNew || Model.IsCodeReadonly)"
                           tabindex="@(Model.IsNew && !Model.IsCodeReadonly ? "1" : "-1")"
                           autofocus="@(Model.IsNew && !Model.IsCodeReadonly ? "autofocus" : null)" />
                    <span asp-validation-for="Article.Code"></span>
                </div>
                <div class="field article-description-field">
                    <label asp-for="Article.Description"></label>
                    <input asp-for="Article.Description" tabindex="2" data-article-description />
                    <span asp-validation-for="Article.Description"></span>
                </div>

                <div class="field article-unit-field article-sales-unit-field">
                    <label asp-for="Article.SalesUnitCode"></label>
                    <select asp-for="Article.SalesUnitCode" asp-items="Model.UnitMeasureItems" tabindex="7">
                        <option value=""></option>
                    </select>
                </div>
                <div class="field article-unit-field article-purchase-unit-field">
                    <label asp-for="Article.PurchaseUnitCode"></label>
                    <select asp-for="Article.PurchaseUnitCode" asp-items="Model.UnitMeasureItems" tabindex="8">
                        <option value=""></option>
                    </select>
                </div>
                <div class="field article-standard-cost-field">
                    <label asp-for="Article.StandardCost"></label>
                    <input asp-for="Article.StandardCost"
                           value="@Quantity(Model.Article.StandardCost)"
                           class="numeric-display"
                           inputmode="decimal"
                           tabindex="12"
                           data-decimal-field
                           data-decimal-integer-digits="7"
                           data-decimal-digits="3" />
                </div>
                <div class="field article-initial-stock-field">
                    <label asp-for="Article.InitialWeight"></label>
                    <input asp-for="Article.InitialWeight"
                           value="@Quantity(Model.Article.InitialWeight)"
                           class="numeric-display"
                           inputmode="decimal"
                           tabindex="11"
                           data-decimal-field
                           data-decimal-integer-digits="7"
                           data-decimal-digits="3" />
                </div>
                <div class="field article-subgroup-field">
                    <label asp-for="Article.SpeciesCode"></label>
                    <select asp-for="Article.SpeciesCode" asp-items="Model.SpeciesItems" tabindex="5">
                        <option value=""></option>
                    </select>
                </div>

                <div class="field article-net-weight-field">
                    <label asp-for="Article.Tare"></label>
                    <input asp-for="Article.Tare"
                           value="@Quantity(Model.Article.Tare)"
                           class="numeric-display"
                           inputmode="decimal"
                           tabindex="9"
                           data-decimal-field
                           data-decimal-integer-digits="7"
                           data-decimal-digits="3" />
                </div>
                <div class="field article-pieces-field">
                    <label asp-for="Article.InitialPackages"></label>
                    <input asp-for="Article.InitialPackages"
                           type="text"
                           inputmode="numeric"
                           autocomplete="off"
                           tabindex="10"
                           data-integer-field />
                </div>
                <div class="field article-category-field">
                    <label asp-for="Article.CategoryCode"></label>
                    <select asp-for="Article.CategoryCode" asp-items="Model.CategoryItems" tabindex="3">
                        <option value=""></option>
                    </select>
                </div>
                <div class="field article-standard-price-field">
                    <label asp-for="Article.StandardPrice"></label>
                    <input asp-for="Article.StandardPrice"
                           value="@Quantity(Model.Article.StandardPrice)"
                           class="currency-display"
                           inputmode="decimal"
                           tabindex="13"
                           data-decimal-field
                           data-decimal-integer-digits="7"
                           data-decimal-digits="3" />
                </div>
                <div class="field article-vat-rate-field">
                    <label asp-for="Article.VatRate"></label>
                    <input asp-for="Article.VatRate"
                           inputmode="decimal"
                           tabindex="15"
                           data-percent-field
                           data-percent-integer-digits="3" />
                </div>

                <div class="field article-group-field">
                    <label asp-for="Article.GroupCode"></label>
                    <select asp-for="Article.GroupCode" asp-items="Model.GroupItems" tabindex="4">
                        <option value=""></option>
                    </select>
                </div>
                <div class="field article-daily-consumption-field">
                    <label asp-for="Article.OriginCode"></label>
                    <select asp-for="Article.OriginCode" asp-items="Model.OriginItems" tabindex="6">
                        <option value=""></option>
                    </select>
                </div>
                <div class="field article-average-cost-field">
                    <label asp-for="Article.VatIncludedPrice"></label>
                    <input asp-for="Article.VatIncludedPrice"
                           value="@Money(Model.Article.VatIncludedPrice)"
                           class="currency-display"
                           inputmode="decimal"
                           tabindex="14"
                           data-money-field
                           data-money-integer-digits="7" />
                </div>

                <div class="field article-supplier-field lookup-field"
                     data-lookup-field
                     data-lookup-type="fornitori"
                     data-lookup-title="Fornitori"
                     data-code-input="Article_SupplierCode"
                     data-code-display="articleSupplierCodeDisplay"
                     data-label-input="articleSupplierNameDisplay">
                    <label asp-for="Article.SupplierCode"></label>
                    <input asp-for="Article.SupplierCode" type="hidden" />
                    <input id="articleSupplierCodeDisplay"
                           class="article-supplier-code-display"
                           type="text"
                           inputmode="numeric"
                           maxlength="5"
                           autocomplete="off"
                           tabindex="16"
                           value="@(Model.Article.SupplierCode?.ToString("00000") ?? "")" />
                    <input id="articleSupplierNameDisplay"
                           class="article-supplier-name-display"
                           type="text"
                           readonly
                           tabindex="-1"
                           value="@Model.Article.SupplierName" />
                    <button class="lookup-button article-supplier-lookup-button"
                            type="button"
                            title="Seleziona fornitore"
                            aria-label="Seleziona fornitore"
                            tabindex="17"
                            data-lookup-open></button>
                    <button class="article-supplier-clear-button"
                            type="button"
                            title="Azzera fornitore"
                            aria-label="Azzera fornitore"
                            tabindex="18"
                            data-article-supplier-clear>x</button>
                </div>
                <div class="field article-supplier-code-field">
                    <label asp-for="Article.SupplierArticleCode"></label>
                    <input asp-for="Article.SupplierArticleCode" tabindex="19" />
                </div>
            </div>
        </fieldset>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-enter-navigation.js" asp-append-version="true"></script>
    <script src="~/js/lookup-fields.js" asp-append-version="true"></script>
    <script src="~/js/article-edit.js" asp-append-version="true"></script>
}
